{
  "name": "american-tile-trails",
  "version": "3.4.0",
  "description": "A Carcassonne-inspired board game set in the United States with McDonalds abbeys and Costco castles.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "sync-help-content": "node scripts/sync-help-content.js en",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:ai-sim": "vitest run src/test/ai.sim.test.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:browser && node scripts/merge-coverage.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "test:coverage:unit": "vitest run --coverage --coverage.reportsDirectory=coverage/unit",
    "test:coverage:browser": "vitest run --config vite.config.ts --project storybook --coverage.enabled --coverage.include=\"src/**/*.{ts,tsx}\" --coverage.exclude=\"src/**/*.stories.tsx\" --coverage.exclude=\"src/test/**\" --coverage.exclude=\"src/**/*.d.ts\" --coverage.reporter=json --coverage.reportsDirectory=coverage/storybook",
    "prepare": "husky"
  },
  "keywords": [
    "board-game",
    "carcassonne",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=10.8.2"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/fiber": "^9.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --fix --no-warn-ignored",
    "*.{ts,tsx,js,mjs,cjs,json,css,md,yml,yaml,html}": "prettier --write"
  }
}
